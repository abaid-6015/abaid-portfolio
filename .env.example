# Set these ONLY in Vercel's server-side Environment Variables or .env.local for local development.
# Do not commit .env.local and never use VITE_ prefix for any of these secrets.
MONGODB_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/?retryWrites=true&w=majority
SESSION_SECRET=REPLACE_WITH_A_CRYPTOGRAPHICALLY_RANDOM_64_CHARACTER_SECRET
ADMIN_BOOTSTRAP_ABAID_PASSWORD=ENTER_YOUR_EXISTING_ABAID_ADMIN_PASSWORD
